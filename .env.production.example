# Mẫu cấu hình production cho docker-compose.prod.yml.
# Sao chép thành .env.production (KHÔNG commit) rồi điền giá trị:
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Sinh secret ngẫu nhiên (mỗi biến một giá trị riêng):
#   openssl rand -hex 32
#   hoặc: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Không dùng giá trị mẫu bắt đầu bằng "dev-" (backend từ chối khởi động ở production).

# ---------- Địa chỉ công khai ----------
# URL công khai đầy đủ (https, không có dấu / cuối). Dùng cho link email, CORS, sitemap, Open Graph.
# NEXT_PUBLIC_SITE_URL được nhúng lúc BUILD: đổi giá trị này thì phải build lại image frontend.
PUBLIC_URL=https://shop.example.com
# Tên miền để Caddy tự xin chứng chỉ Let's Encrypt (phải trỏ DNS về VPS, mở cổng 80/443).
# Đặt "localhost" để thử cục bộ (chứng chỉ từ CA nội bộ của Caddy).
SITE_ADDRESS=shop.example.com
# Email đăng ký ACME (nhận thông báo hết hạn chứng chỉ); có thể để trống
ACME_EMAIL=
# Cổng Caddy nghe (host = container, tự giữ đúng cổng khi redirect http -> https). Production thật để 80/443
# (Let's Encrypt chỉ kiểm tra 80/443); chỉ đổi khi thử cục bộ, ví dụ 8080/8443. SITE_ADDRESS KHÔNG kèm cổng.
HTTP_PORT=80
HTTPS_PORT=443

# ---------- Postgres ----------
POSTGRES_USER=beanbox
POSTGRES_DB=beanbox
# Dùng chuỗi hex (openssl rand -hex 24) để không có ký tự đặc biệt làm hỏng DATABASE_URL
POSTGRES_PASSWORD=

# ---------- Secret ứng dụng (>= 32 ký tự, ngẫu nhiên, mỗi biến một giá trị) ----------
JWT_ACCESS_SECRET=
# Dùng CHUNG cho backend và frontend (compose truyền cùng một giá trị cho cả hai)
INTERNAL_API_SECRET=
# Khóa AES-256-GCM mã hóa secret xác thực 2 lớp (2FA) lưu trong DB: đúng 32 byte, dạng base64 hoặc 64 ký tự hex.
# Sinh bằng: openssl rand -base64 32. BẮT BUỘC ở production; khóa mẫu dev (bắt đầu bằng "beanbox-dev-") bị từ chối.
# Mất/đổi khóa thì mọi tài khoản đã bật 2FA không đăng nhập được cho tới khi Admin đặt lại 2FA (secret cũ không giải mã được).
TOTP_ENCRYPTION_KEY=

# ---------- Cookie ----------
# production chạy sau HTTPS nên để true
COOKIE_SECURE=true

# ---------- Email (SMTP thật; production không có Mailpit) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# D-056: cổng 465 -> SMTP_SECURE=true; cổng 587 (STARTTLS) -> để SMTP_SECURE trống/false.
# SMTP_REQUIRE_TLS bỏ trống = true ở production (từ chối gửi nếu server không hỗ trợ TLS).
SMTP_SECURE=
SMTP_REQUIRE_TLS=
MAIL_FROM=BeanBox <no-reply@shop.example.com>

# ---------- Thanh toán (chỉ khóa sandbox/test; để trống = tắt phương thức đó) ----------
# Hướng dẫn: docs/payments-setup.md
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Để trống = dùng URL sandbox mặc định; VNPAY_RETURN_URL trống = ${PUBLIC_URL}/thanh-toan/ket-qua?provider=vnpay
VNPAY_PAYMENT_URL=
VNPAY_RETURN_URL=
# Chỉ sk_test_... (khóa live bị backend từ chối)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Cloudflare Turnstile cho form liên hệ (trống = tắt; phải có ĐỦ CẢ HAI mới bật) ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Vận hành ----------
# Số ngày giữ tin nhắn liên hệ đã xử lý/spam (0 = tắt). Đổi khác 365 thì sửa trang chính sách bảo mật cho khớp.
CONTACT_RETENTION_DAYS=365
JOBS_ENABLED=true
LOG_LEVEL=info
# Giới hạn backend theo IP (request/phút)
GENERAL_RATE_LIMIT_PER_MIN=100
# Nhóm auth (đăng nhập, đăng ký, quên/đặt lại/đổi mật khẩu). Production giữ 5.
AUTH_RATE_LIMIT_PER_MIN=5
ORDER_RATE_LIMIT_PER_MIN=10
COUPON_RATE_LIMIT_PER_MIN=10
QUOTE_RATE_LIMIT_PER_MIN=30
# Xuất CSV phân tích (GET /admin/analytics/export), theo IP.
EXPORT_RATE_LIMIT_PER_MIN=10
# Đơn COD khách vãng lai (D-057): giờ giữ kho tối đa khi chưa được xác nhận (1..720) và số đơn đang chờ
# tối đa cho mỗi SĐT/email (1..100). Bỏ trống = 48 và 3.
GUEST_COD_HOLD_HOURS=
GUEST_COD_MAX_OPEN=
# Kết nối DB (D-058): pool chính (mặc định 10), pool riêng cho phân tích (mặc định 4) và thời gian tối đa
# một truy vấn phân tích, ms, 1000..120000 (mặc định 15000). Bỏ trống = mặc định.
DATABASE_POOL_MAX=
ANALYTICS_POOL_MAX=
ANALYTICS_STATEMENT_TIMEOUT_MS=

# ---------- Rate limit ở Caddy (request/phút/IP) ----------
EDGE_RATE_AUTH_PER_MIN=30
EDGE_RATE_API_PER_MIN=300
EDGE_RATE_WEB_PER_MIN=600

# ---------- Backup (profile backup) ----------
# Off-site (rclone + age), heartbeat: cấu hình trong file RIÊNG .env.backup (mẫu .env.backup.example), không để ở đây.
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400

# ---------- Seed dữ liệu demo (profile tools; chỉ điền khi cần seed) ----------
# Mỗi mật khẩu >= 12 ký tự, có chữ và số, KHÁC giá trị mẫu trong backend/.env.example.
# Chạy: docker compose --env-file .env.production -f docker-compose.prod.yml --profile tools run --rm seed
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=
