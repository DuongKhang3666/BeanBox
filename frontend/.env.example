# URL backend mà Next.js (server/rewrites) dùng để gọi API. Docker: http://backend:4000
API_INTERNAL_URL=http://localhost:4000
# URL công khai của website (dùng cho sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Bí mật dùng chung giữa SSR (server-side) và backend để miễn rate limit chung (D-009).
# PHẢI trùng INTERNAL_API_SECRET của backend; đổi ở môi trường thật. KHÔNG thêm tiền tố NEXT_PUBLIC_.
INTERNAL_API_SECRET=dev-internal-secret-change-me-0123456789abcdef
