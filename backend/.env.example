# Sao chép thành backend/.env (không commit file .env)

NODE_ENV=development
PORT=4000
# Địa chỉ bind. Dev: 127.0.0.1 (chỉ máy này gọi được). Trong container đặt 0.0.0.0.
HOST=127.0.0.1
# Proxy tin cậy cho X-Forwarded-For: false | số hop | loopback,uniquelocal,IP/CIDR. KHÔNG dùng "true".
TRUST_PROXY=loopback
LOG_LEVEL=info

# Postgres chạy bằng `docker compose up -d db` ở thư mục gốc
DATABASE_URL=postgresql://beanbox:beanbox@localhost:5432/beanbox
# Tùy chọn (Prisma 7, đọc qua prisma.config.ts): DB shadow cho `migrate dev` / `migrate diff --from-migrations`.
# Phải là DB KHÁC DATABASE_URL. Bỏ trống thì Prisma tự tạo/xóa DB shadow tạm khi cần.
# SHADOW_DATABASE_URL=postgresql://beanbox:beanbox@localhost:5432/beanbox_shadow

# Origin frontend, phân tách bằng dấu phẩy (CORS + kiểm tra Origin)
FRONTEND_ORIGINS=http://localhost:3000

# Chuỗi ngẫu nhiên >= 32 ký tự. Giá trị dưới đây CHỈ dùng cho dev, hãy đổi ở môi trường thật.
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
# Dạng <số>s|m|h
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# D-063: khóa AES-256-GCM mã hóa secret xác thực 2 lớp (2FA) trong DB: đúng 32 byte, base64 hoặc 64 ký tự hex.
# Giá trị dưới đây là khóa MẪU DEV (32 byte ASCII "beanbox-dev-totp-key-localhost!!"), CHỈ dùng trên localhost;
# production từ chối khóa bắt đầu bằng "beanbox-dev-". Sinh khóa thật: openssl rand -base64 32.
# Bỏ trống = tính năng 2FA tắt (bật 2FA trả 503; user đã bật 2FA không đăng nhập được).
TOTP_ENCRYPTION_KEY=YmVhbmJveC1kZXYtdG90cC1rZXktbG9jYWxob3N0ISE=

# D-070: true = tài khoản ADMIN phải bật 2FA mới dùng được /admin/* (403 ADMIN_TWO_FACTOR_REQUIRED). STAFF không bị áp.
# Mặc định false (bản demo, mọi luồng/E2E giữ nguyên). NÊN bật true khi chạy thật (cần TOTP_ENCRYPTION_KEY hợp lệ).
REQUIRE_ADMIN_2FA=false

# Bí mật dùng chung giữa frontend (server-side) và backend để bỏ qua rate limit chung. >= 32 ký tự.
# PHẢI trùng giá trị ở frontend; đổi ở môi trường thật. Không đặt = tắt cơ chế này.
INTERNAL_API_SECRET=dev-internal-secret-change-me-0123456789abcdef

# Gốc URL frontend dùng dựng link trong email (không bao giờ lấy từ header Host/Origin)
WEB_APP_URL=http://localhost:3000

# Cờ Secure của cookie. Bỏ trống: true khi production, false còn lại.
COOKIE_SECURE=

# Mailpit (UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# TLS (D-056). SMTP_SECURE=true: TLS ngầm định (thường cổng 465). Mặc định false (STARTTLS cơ hội).
# SMTP_REQUIRE_TLS: bắt buộc nâng cấp TLS trước khi gửi; bỏ trống = true khi production, false còn lại.
# Mailpit không có TLS nên dev để trống/false.
SMTP_SECURE=
SMTP_REQUIRE_TLS=
MAIL_FROM=BeanBox <no-reply@beanbox.local>

# Thanh toán online (M5) - để trống khi chưa dùng (phương thức tương ứng sẽ tắt).
# Hướng dẫn lấy khóa sandbox: docs/payments-setup.md. KHÔNG commit giá trị thật.
# VNPay bật khi có cả TMN_CODE và HASH_SECRET.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# URL cổng thanh toán sandbox (bắt buộc https)
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Trang FE nhận kết quả sau khi thanh toán xong (mặc định: ${WEB_APP_URL}/thanh-toan/ket-qua?provider=vnpay)
VNPAY_RETURN_URL=http://localhost:3000/thanh-toan/ket-qua?provider=vnpay
# Stripe bật khi có khóa. CHỈ sk_test_ (sk_live_ bị backend từ chối khởi động). Xem docs/payments-setup.md
STRIPE_SECRET_KEY=
# whsec_... lấy từ `stripe listen` hoặc Dashboard; tùy chọn (thiếu thì dùng sync ở trang kết quả)
STRIPE_WEBHOOK_SECRET=

# --- Chế độ giả lập cho demo (D-060, D-061). MẶC ĐỊNH TẮT. Không có tiền thật, không gọi dịch vụ ngoài. ---
# true: VNPay và MoMo dùng cổng thanh toán GIẢ do chính app phục vụ (/cong-thanh-toan-gia-lap).
# Backend TỪ CHỐI khởi động khi NODE_ENV=production hoặc khi đã đặt VNPAY_TMN_CODE. Chỉ dùng trên máy dev/demo.
PAYMENT_MOCKS_ENABLED=
# Khóa ký của cổng giả (>= 16 ký tự). Để trống: tự sinh ngẫu nhiên mỗi lần khởi động (có cảnh báo).
# Ví dụ giá trị giả: demo-only-mock-secret-0123456789
PAYMENT_MOCK_SECRET=
# true: bật phương thức Chuyển khoản / VietQR. Tài khoản nhận nằm ở Admin > Cài đặt (mặc định BIN demo 999999).
BANK_TRANSFER_ENABLED=
# Số giờ giữ đơn chờ chuyển khoản (1..72, mặc định 24)
BANK_TRANSFER_HOLD_HOURS=

# Giới hạn số request/phút/IP (D-011, D-016). Đặt cao hơn khi chạy e2e/demo.
# Giới hạn chung toàn API (mặc định 100). E2E/CI đặt 1000 để chạy liền mạch; production giữ mặc định.
GENERAL_RATE_LIMIT_PER_MIN=100
# Nhóm auth (login, register, forgot/reset/change-password), mặc định 5. E2E/CI đặt 30; production giữ 5.
AUTH_RATE_LIMIT_PER_MIN=5
ORDER_RATE_LIMIT_PER_MIN=10
COUPON_RATE_LIMIT_PER_MIN=10
QUOTE_RATE_LIMIT_PER_MIN=30
# Xuất CSV phân tích (GET /admin/analytics/export), theo IP. Production giữ 10.
EXPORT_RATE_LIMIT_PER_MIN=10

# Captcha form liên hệ (Cloudflare Turnstile, D-028). Đủ CẢ HAI mới bật; chỉ đặt một trong hai là lỗi
# và backend dừng khi khởi động. Lấy khóa ở Cloudflare dashboard, xem docs/deployment.md. Để trống = tắt.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Số ngày giữ tin liên hệ đã xử lý (RESOLVED/SPAM) trước khi job nền xóa cứng (D-029). 0 = tắt job xóa.
CONTACT_RETENTION_DAYS=365

# Đơn COD của khách vãng lai (D-057). Quá GUEST_COD_HOLD_HOURS giờ (1..720, mặc định 48) mà chưa được
# xác nhận thì job nền tự hủy và hoàn kho. Mỗi SĐT hoặc email chỉ được có tối đa GUEST_COD_MAX_OPEN
# (1..100, mặc định 3) đơn COD khách vãng lai đang chờ xác nhận.
GUEST_COD_HOLD_HOURS=48
GUEST_COD_MAX_OPEN=3

# Kết nối DB (D-058). DATABASE_POOL_MAX: pool chính (mặc định 10). Truy vấn phân tích dùng pool riêng
# ANALYTICS_POOL_MAX (mặc định 4) và bị Postgres hủy sau ANALYTICS_STATEMENT_TIMEOUT_MS ms (1000..120000,
# mặc định 15000) -> API trả 503 ANALYTICS_TIMEOUT.
DATABASE_POOL_MAX=10
ANALYTICS_POOL_MAX=4
ANALYTICS_STATEMENT_TIMEOUT_MS=15000

# Job nền (dọn dẹp, hủy đơn quá hạn thanh toán, hủy đơn COD guest quá hạn xác nhận). Mặc định true; luôn tắt khi NODE_ENV=test.
JOBS_ENABLED=true

# Tắt êm (D-079): khi nhận SIGTERM/SIGINT hoặc lỗi không bắt được, API ngừng nhận kết nối, chờ request và job
# nền đang chạy, đóng DB rồi thoát; quá SHUTDOWN_TIMEOUT_MS (ms, 1000..120000, mặc định 25000) thì thoát với mã 1.
# Phải nhỏ hơn stop_grace_period của compose (30s).
SHUTDOWN_TIMEOUT_MS=25000

# Ảnh đại diện (D-081): avatarUrl chỉ nhận `/uploads/...` hoặc URL https có host trong danh sách này
# (phân tách dấu phẩy, ví dụ cdn.example.com). Rỗng = chỉ nhận /uploads. Dữ liệu cũ không hợp lệ không bị
# xóa nhưng không được hiển thị. Frontend dùng NEXT_PUBLIC_AVATAR_URL_HOSTS (lúc build) cùng giá trị.
AVATAR_URL_HOSTS=

# Mật khẩu tài khoản seed (chỉ dev; >= 8 ký tự, có chữ và số). Mặc định seed từ chối chạy khi NODE_ENV=production.
# Muốn seed ở production (D-031) phải đặt SEED_ALLOW_PRODUCTION=true (mặc định KHÔNG đặt) và cả 3 mật khẩu
# phải >= 12 ký tự, có chữ và số, KHÔNG dùng giá trị mẫu bên dưới.
SEED_ADMIN_PASSWORD=Admin12345
SEED_STAFF_PASSWORD=Staff12345
SEED_CUSTOMER_PASSWORD=Customer12345
