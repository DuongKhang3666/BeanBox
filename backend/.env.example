# Sao chép thành backend/.env (không commit file .env)

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres chạy bằng `docker compose up -d db` ở thư mục gốc
DATABASE_URL=postgresql://beanbox:beanbox@localhost:5432/beanbox

# Origin frontend, phân tách bằng dấu phẩy (CORS + kiểm tra Origin)
FRONTEND_ORIGINS=http://localhost:3000

# Chuỗi ngẫu nhiên >= 32 ký tự. Giá trị dưới đây CHỈ dùng cho dev, hãy đổi ở môi trường thật.
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Mailpit (UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BeanBox <no-reply@beanbox.local>

# Thanh toán (M5) - để trống khi chưa dùng
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/thanh-toan/ket-qua
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mật khẩu tài khoản seed (chỉ dev; >= 8 ký tự, có chữ và số). Seed từ chối chạy khi NODE_ENV=production.
SEED_ADMIN_PASSWORD=Admin12345
SEED_STAFF_PASSWORD=Staff12345
SEED_CUSTOMER_PASSWORD=Customer12345
