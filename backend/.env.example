# Sao chép thành backend/.env (không commit file .env)

NODE_ENV=development
PORT=4000
# Địa chỉ bind. Dev: 127.0.0.1 (chỉ máy này gọi được). Trong container đặt 0.0.0.0.
HOST=127.0.0.1
# Proxy tin cậy cho X-Forwarded-For: false | số hop | loopback,uniquelocal,IP/CIDR. KHÔNG dùng "true".
TRUST_PROXY=loopback
LOG_LEVEL=info

# Postgres chạy bằng `docker compose up -d db` ở thư mục gốc
DATABASE_URL=postgresql://beanbox:beanbox@localhost:5432/beanbox
# Tùy chọn (Prisma 7, đọc qua prisma.config.ts): DB shadow cho `migrate dev` / `migrate diff --from-migrations`.
# Phải là DB KHÁC DATABASE_URL. Bỏ trống thì Prisma tự tạo/xóa DB shadow tạm khi cần.
# SHADOW_DATABASE_URL=postgresql://beanbox:beanbox@localhost:5432/beanbox_shadow

# Origin frontend, phân tách bằng dấu phẩy (CORS + kiểm tra Origin)
FRONTEND_ORIGINS=http://localhost:3000

# Chuỗi ngẫu nhiên >= 32 ký tự. Giá trị dưới đây CHỈ dùng cho dev, hãy đổi ở môi trường thật.
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
# Dạng <số>s|m|h
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Bí mật dùng chung giữa frontend (server-side) và backend để bỏ qua rate limit chung. >= 32 ký tự.
# PHẢI trùng giá trị ở frontend; đổi ở môi trường thật. Không đặt = tắt cơ chế này.
INTERNAL_API_SECRET=dev-internal-secret-change-me-0123456789abcdef

# Gốc URL frontend dùng dựng link trong email (không bao giờ lấy từ header Host/Origin)
WEB_APP_URL=http://localhost:3000

# Cờ Secure của cookie. Bỏ trống: true khi production, false còn lại.
COOKIE_SECURE=

# Mailpit (UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BeanBox <no-reply@beanbox.local>

# Thanh toán online (M5) - để trống khi chưa dùng (phương thức tương ứng sẽ tắt).
# Hướng dẫn lấy khóa sandbox: docs/payments-setup.md. KHÔNG commit giá trị thật.
# VNPay bật khi có cả TMN_CODE và HASH_SECRET.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# URL cổng thanh toán sandbox (bắt buộc https)
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Trang FE nhận kết quả sau khi thanh toán xong (mặc định: ${WEB_APP_URL}/thanh-toan/ket-qua?provider=vnpay)
VNPAY_RETURN_URL=http://localhost:3000/thanh-toan/ket-qua?provider=vnpay
# Stripe bật khi có khóa. CHỈ sk_test_ (sk_live_ bị backend từ chối khởi động). Xem docs/payments-setup.md
STRIPE_SECRET_KEY=
# whsec_... lấy từ `stripe listen` hoặc Dashboard; tùy chọn (thiếu thì dùng sync ở trang kết quả)
STRIPE_WEBHOOK_SECRET=

# Giới hạn số request/phút/IP (D-011, D-016). Đặt cao hơn khi chạy e2e/demo.
# Giới hạn chung toàn API (mặc định 100). E2E/CI đặt 1000 để chạy liền mạch; production giữ mặc định.
GENERAL_RATE_LIMIT_PER_MIN=100
ORDER_RATE_LIMIT_PER_MIN=10
COUPON_RATE_LIMIT_PER_MIN=10
QUOTE_RATE_LIMIT_PER_MIN=30

# Captcha form liên hệ (Cloudflare Turnstile, D-028). Đủ CẢ HAI mới bật; chỉ đặt một trong hai là lỗi
# và backend dừng khi khởi động. Lấy khóa ở Cloudflare dashboard, xem docs/deployment.md. Để trống = tắt.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Số ngày giữ tin liên hệ đã xử lý (RESOLVED/SPAM) trước khi job nền xóa cứng (D-029). 0 = tắt job xóa.
CONTACT_RETENTION_DAYS=365

# Job nền (dọn dẹp, hủy đơn quá hạn thanh toán). Mặc định true; luôn tắt khi NODE_ENV=test.
JOBS_ENABLED=true

# Mật khẩu tài khoản seed (chỉ dev; >= 8 ký tự, có chữ và số). Mặc định seed từ chối chạy khi NODE_ENV=production.
# Muốn seed ở production (D-031) phải đặt SEED_ALLOW_PRODUCTION=true (mặc định KHÔNG đặt) và cả 3 mật khẩu
# phải >= 12 ký tự, có chữ và số, KHÔNG dùng giá trị mẫu bên dưới.
SEED_ADMIN_PASSWORD=Admin12345
SEED_STAFF_PASSWORD=Staff12345
SEED_CUSTOMER_PASSWORD=Customer12345
