# Mẫu cấu hình backup OFF-SITE cho service `backup` (M8, docs/deployment.md mục 11).
# Sao chép thành .env.backup (KHÔNG commit, chmod 600) rồi điền:
#   cp .env.backup.example .env.backup && chmod 600 .env.backup
# File này được nạp RIÊNG vào container `backup` (compose: env_file, tùy chọn). Container này KHÔNG nhận
# .env.production nên không thấy JWT/secret khác của ứng dụng. Muốn để file ở chỗ khác: đặt biến
# BACKUP_ENV_FILE=<đường dẫn> khi chạy compose. Không có file = off-site TẮT (vẫn backup cục bộ như cũ).
#
# Lưu ý định dạng: một dòng một biến, không có dấu cách quanh `=`. Compose nội suy `$` trong file này;
# nếu giá trị có ký tự `$`, bọc cả giá trị trong dấu nháy đơn 'như-vậy'.

# ---------- Bật off-site ----------
# Dạng <tên-remote>:<bucket>/<thư-mục>. Tên remote khớp với <TÊN> của RCLONE_CONFIG_<TÊN>_* bên dưới
# (rclone đọc tên remote không phân biệt hoa thường). Để trống = TẮT off-site.
BACKUP_REMOTE=offsite:<TÊN_BUCKET>/prod

# ---------- Khai báo remote (chọn MỘT khối, xóa các khối còn lại) ----------
# Nên dùng access key chỉ có quyền trên đúng bucket này (không dùng khóa root của tài khoản).

# (1) Amazon S3
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=<ACCESS_KEY_ID>
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
RCLONE_CONFIG_OFFSITE_REGION=<REGION>
# Bucket đã tạo sẵn, key không có quyền tạo bucket: bỏ bước kiểm/tạo bucket
RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true

# (2) Backblaze B2 qua giao diện S3-compatible (tạo "Application Key" giới hạn theo bucket)
#     Endpoint dạng https://s3.<REGION>.backblazeb2.com (xem trong trang bucket)
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=<KEY_ID>
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=<APPLICATION_KEY>
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.<REGION>.backblazeb2.com
# RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true

# (3) Cloudflare R2 (tạo API token giới hạn theo bucket, quyền Object Read & Write)
#     Endpoint dạng https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=<ACCESS_KEY_ID>
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# RCLONE_CONFIG_OFFSITE_REGION=auto
# RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true

# ---------- Mã hóa phía client bằng age ----------
# VPS chỉ giữ KHÓA CÔNG KHAI. Khóa bí mật (identity) do chủ dự án giữ offline, chỉ dùng lúc khôi phục.
# Sinh khóa trên máy của bạn (không phải VPS): age-keygen -o beanbox-age.key   (in ra dòng "Public key: age1...")
# Một hoặc nhiều public key, cách nhau dấu phẩy hoặc khoảng trắng:
BACKUP_AGE_RECIPIENTS=<age1...PUBLIC_KEY>
# Hoặc dùng file (mỗi dòng một khóa, # là chú thích); đường dẫn trong container:
# BACKUP_AGE_RECIPIENTS_FILE=/deploy/backup/recipients.txt
# Chỉ đặt `none` khi remote đã được mã hóa ở lớp khác (ví dụ rclone crypt). Mặc định: age.
# Không có recipient mà không đặt none: backup từ chối đẩy off-site (thoát mã 4), không bao giờ đẩy bản thô.
# BACKUP_REMOTE_ENCRYPTION=age

# ---------- Kiểm toàn vẹn, xoay vòng, heartbeat (tùy chọn) ----------
# hash (mặc định): so hash/kích thước backend lưu. download: tải về so nội dung thật (tốn băng thông).
# BACKUP_REMOTE_VERIFY=hash
# Giữ bản trên remote theo tên thư mục <TS>; luôn giữ tối thiểu MIN_KEEP bản mới nhất kể cả khi quá hạn.
# BACKUP_REMOTE_RETENTION_DAYS=30
# BACKUP_REMOTE_MIN_KEEP=3
# URL heartbeat (Better Stack, Uptime Kuma push, Healthchecks...). Chứa token: giữ bí mật. Gọi khi backup
# (gồm off-site nếu bật) thành công; FAIL_URL gọi khi lỗi.
# BACKUP_HEARTBEAT_URL=<URL_HEARTBEAT_THANH_CONG>
# BACKUP_HEARTBEAT_FAIL_URL=<URL_HEARTBEAT_LOI>
